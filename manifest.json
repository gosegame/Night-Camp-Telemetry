{
  "manifest_version": 3,
  "name": "Night Camp Telemetry",
  "short_name": "NC Telemetry",
  "version": "1.0.0",
  "description": "Read-only Season 2 combat, per-skill, per-rune, elemental, survival & economy telemetry in Chrome Side Panel (zero in-game UI).",
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://play.nightcamp.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Night Camp Telemetry",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://play.nightcamp.app/*"
      ],
      "js": [
        "main-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://play.nightcamp.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
